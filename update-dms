#!/bin/bash
set -euo pipefail

REPO="Ravi-Kishor/dms-shell-git"
PKG_NAME="dux-shell"
OLD_PKG_NAME="dms-shell-git"

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "❌ Required command '$1' not found"
    exit 1
  }
}

require aria2c
require curl
require jq
require sudo
require pacman

# Match exact installed package name in column 1 (ignores virtual 'provides')
get_installed_version() {
  pacman -Q 2>/dev/null | awk -v pkg="$1" '$1 == pkg {print $2; found=1; exit} END {if (!found) print "Not Installed"}'
}

INSTALLED_VERSION=$(get_installed_version "$PKG_NAME")
OLD_INSTALLED_VERSION=$(get_installed_version "$OLD_PKG_NAME")

echo "Installed $PKG_NAME version: $INSTALLED_VERSION"
echo "Installed old package version: $OLD_INSTALLED_VERSION"
echo
echo "📡 Fetching latest release metadata…"

RELEASE_JSON=$(curl -fsSL "https://api.github.com/repos/$REPO/releases/latest")

TAG_NAME=$(echo "$RELEASE_JSON" | jq -r '.tag_name')
echo "Latest release tag: $TAG_NAME"

# Prefer x86_64_v3, fallback to generic x86_64 (excluding -debug packages).
ASSET_URL=$(echo "$RELEASE_JSON" | jq -r '
  .assets[]
  | select(.name | test("^dux-shell-.*-x86_64_v3\\.pkg\\.tar\\.zst$"))
  | select(.name | test("-debug-") | not)
  | .browser_download_url
' | head -n1)

if [[ -z "$ASSET_URL" || "$ASSET_URL" == "null" ]]; then
  ASSET_URL=$(echo "$RELEASE_JSON" | jq -r '
    .assets[]
    | select(.name | test("^dux-shell-.*-x86_64\\.pkg\\.tar\\.zst$"))
    | select(.name | test("-debug-") | not)
    | .browser_download_url
  ' | head -n1)
fi

if [[ -z "$ASSET_URL" || "$ASSET_URL" == "null" ]]; then
  echo "❌ Could not find dux-shell package in release $TAG_NAME"
  exit 1
fi

PKG_FILE=$(basename "$ASSET_URL")

LATEST_VERSION=$(echo "$PKG_FILE" | sed -E \
  's/^dux-shell-(.*)-x86_64(_v3)?\.pkg\.tar\.zst$/\1/')

if [[ "$LATEST_VERSION" == "$PKG_FILE" ]]; then
  echo "❌ Could not extract package version from $PKG_FILE"
  exit 1
fi

echo "Latest package version: $LATEST_VERSION"
echo

echo "Choose an action:"
echo "1) Update (skip if already latest)"
echo "2) Force install"
read -rp "Enter choice (1/2): " CHOICE

if [[ "$CHOICE" == "1" ]]; then
  if [[ "$INSTALLED_VERSION" == "$LATEST_VERSION" ]]; then
    echo "✅ dux-shell is already up to date"
    exit 0
  fi

  echo "⬆️ Updating dux-shell $INSTALLED_VERSION → $LATEST_VERSION"

elif [[ "$CHOICE" == "2" ]]; then
  echo "🛠️ Force installing dux-shell $LATEST_VERSION"

else
  echo "❌ Invalid choice"
  exit 1
fi

TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT

cd "$TMP_DIR"

echo "📥 Downloading (8 connections with aria2)..."
echo "   $PKG_FILE"

aria2c -x 8 -s 8 -k 1M -o "$PKG_FILE" "$ASSET_URL"

echo "📦 Installing package..."

if [[ "$OLD_INSTALLED_VERSION" != "Not Installed" ]]; then
  echo "🔄 Replacing old package: $OLD_PKG_NAME"

  sudo pacman -Rdd --noconfirm "$OLD_PKG_NAME"
fi

sudo pacman -U --noconfirm "$PKG_FILE"

echo
echo "✅ dux-shell $LATEST_VERSION installed successfully!"
